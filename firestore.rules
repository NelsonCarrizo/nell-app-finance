rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo vos vas a poder entrar: no hay pantalla de registro en la app,
    // así que el único usuario que puede autenticarse es el que crees
    // a mano en Firebase Console > Authentication.
    // Si querés, más adelante podés reemplazar esta línea por:
    //   request.auth.uid == "TU_UID_AQUI"
    // para dejar afuera incluso a otra cuenta que alguna vez crees por error.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
